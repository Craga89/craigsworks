# Response headers for the site on Cloudflare (Workers static assets). Copied into site/ by ci.yml's
# deploy job (the live site) and by the Preview workflow, which adds X-Robots-Tag: noindex. The
# Content-Security-Policy stays in each page's <meta>: Astro writes per-page hashes there.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Astro's bundled files have a content hash in their names, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
