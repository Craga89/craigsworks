{
  "name": "craigsworks.com",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "serve": "node tools/lib/serve.mjs site",
    "fonts": "node tools/fetch-fonts.mjs",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "astro check && tsc -p tsconfig.node.json",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "node --test --experimental-test-coverage --test-coverage-include=\"tools/lib/**\" --test-coverage-lines=95 --test-coverage-branches=80 --test-coverage-functions=90 \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "test:a11y": "playwright test --project=a11y-desktop --project=a11y-mobile",
    "verify": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test:unit"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/sitemap": "3.7.4",
    "@axe-core/playwright": "4.14.0",
    "@emnapi/runtime": "1.11.3",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "astro": "7.4.8",
    "axe-core": "4.14.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "playwright": "1.65.0",
    "typescript": "6.0.3",
    "wrangler": "4.159.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.15.0"
}
