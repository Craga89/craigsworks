---
// The call to action at the end of every page; every "book a call" link lands here.
import { MAILTO, EMAIL } from '../site';

interface Props {
  title?: string;
  body?: string;
}
const {
  title = 'Got something slowing you down?',
  body = "Tell me about it on a free 30-minute call. If I can help, I'll say how; if I can't, I'll say that too, and point you somewhere better if I know of somewhere.",
} = Astro.props;
---

<section id="contact" class="section wrap" aria-labelledby="contact-title">
  <div class="box on-dark pop">
    <div class="copy">
      <h2 id="contact-title">{title}</h2>
      <p>
        {body} Or email <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.
      </p>
    </div>
    <div class="beam ring">
      <a class="go" href={MAILTO}>Book a free call <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: clamp(32px, 6vw, 72px);
    border-radius: 36px;
    border: 1px solid var(--dark-edge);
    background: var(--dark);
    color: #ffffff;
  }
  .copy {
    flex: 999 1 520px;
    min-width: 0;
  }
  h2 {
    margin: 0 0 14px;
    font-weight: 700;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 0.98;
    letter-spacing: -0.05em;
  }
  p {
    margin: 0;
    font-size: 1.1875rem;
    color: var(--dark-text);
  }
  p a {
    color: #ffffff;
    overflow-wrap: anywhere;
  }
  .ring {
    display: inline-block;
    padding: 2px;
    border-radius: 18px;
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 60px;
    padding: 0 28px;
    border-radius: 16px;
    background: #ffffff;
    color: #1e1a16;
    font-weight: 700;
    font-size: 1.125rem;
    text-decoration: none;
  }
  .go:hover {
    color: #8a5a22;
  }
</style>
