---
// The site header: the name, availability and the main links. Sticky on wider screens only, so
// on a phone it never covers what has focus.
import Logo from './Logo.astro';
import { url } from '../site';

interface Props {
  /** The section the page belongs to, marked as current in the links. */
  current?: 'services' | 'work' | 'about';
  /** Whether the page ends with the contact section; if not, "Book a call" goes to the home page's. */
  contact?: boolean;
}
const { current, contact = true } = Astro.props;
const links = [
  { key: 'services', text: 'Services', href: url('#services') },
  { key: 'work', text: 'Case notes', href: url('work/') },
  { key: 'about', text: 'About', href: url('about/') },
];
---

<header class="hdr">
  <div class="bar">
    <div class="id">
      <a class="brand" href={url()}>
        <Logo />
        <span class="visually-hidden">craigsworks</span>
      </a>
      <p class="status mono"><span class="dot pulse" aria-hidden="true"></span>Open to new projects</p>
    </div>
    <nav aria-label="Main">
      <ul class="links">
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={l.key === current ? 'page' : undefined}>
                {l.text}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="actions">
        <li>
          <button type="button" class="theme" data-theme-toggle aria-pressed="false" hidden>
            <svg class="moon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
            </svg>
            <svg class="sun" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="4.5" />
              <path
                d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"
              />
            </svg>
            <span class="visually-hidden">Dark theme</span>
          </button>
        </li>
        <li><a class="btn btn-dark" href={contact ? '#contact' : url('#contact')}>Book a call</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .hdr {
    padding: 12px 16px 0;
    z-index: 10;
  }
  @media (min-width: 761px) {
    .hdr {
      position: sticky;
      top: 0;
    }
  }
  .bar {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 8px 8px 8px 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 12px;
    background: var(--bar);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--line);
    border-radius: 18px;
  }
  .id {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 14px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--ink);
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .status {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--acc-mid);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 24px;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 24px;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .actions {
    gap: 8px;
  }
  ul a:not(.btn) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  ul a:not(.btn):hover,
  ul a[aria-current='page'] {
    text-decoration: underline;
  }
  ul a[aria-current='page'] {
    text-decoration-thickness: 2px;
    text-decoration-color: var(--acc-mid);
  }
  .theme {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--tile);
    color: var(--ink);
    cursor: pointer;
  }
  .theme:hover {
    border-color: var(--line2);
  }
  .theme[hidden] {
    display: none;
  }
  .theme svg {
    grid-area: 1 / 1;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* The moon to go dark, the sun to go light. */
  .sun,
  .theme[aria-pressed='true'] .moon {
    display: none;
  }
  .theme[aria-pressed='true'] .sun {
    display: block;
  }
  /* On a phone, two rows: the name with the theme switch and "Book a call", then the links. */
  @media (max-width: 760px) {
    .hdr {
      padding: 10px 12px 0;
    }
    .bar {
      position: relative;
      display: block;
      padding: 6px 6px 0 14px;
    }
    .status {
      display: none;
    }
    .id {
      min-height: 44px;
    }
    nav {
      display: block;
    }
    .links {
      gap: 0 20px;
      margin-top: 6px;
      border-top: 1px solid var(--line);
    }
    .actions {
      position: absolute;
      top: 6px;
      right: 6px;
      gap: 6px;
    }
    .actions .btn {
      min-height: 44px;
      padding: 0 14px;
      font-size: 0.875rem;
    }
  }
  @media (max-width: 400px) {
    .brand :global(.logo) {
      width: 112px;
      height: auto;
    }
    .actions .btn {
      padding: 0 12px;
    }
  }
</style>
