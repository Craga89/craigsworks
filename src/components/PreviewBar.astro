---
// On branch Previews only: a bar across the top saying this is a preview of a branch, not the live
// site, with a link to the live site. Each Preview has an address of its own (no list of them).
import { LIVE, PREVIEW } from '../site';
---

{
  PREVIEW && (
    <aside class="preview" aria-label="Branch preview">
      <p>
        <strong>Branch preview</strong> of <code>{PREVIEW}</code>, built before the checks run.
        <a href={LIVE}>Live site</a>
      </p>
    </aside>
  )
}

<style>
  .preview {
    background: var(--dark);
    border-bottom: 1px solid var(--dark-edge);
    color: #ffffff;
    font-size: 0.875rem;
  }
  p {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 8px 24px;
  }
  code {
    font-family: var(--f-mono);
    color: var(--dark-acc);
  }
  a {
    color: #ffffff;
  }
  a:focus-visible {
    outline-color: #ffffff;
  }
</style>
