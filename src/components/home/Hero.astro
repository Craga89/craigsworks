---
// The opening: who this is and what it's for, with a health check typing itself out beside it.
import Terminal from '../ui/Terminal.astro';
import Icon from '../ui/Icon.astro';
import { HERO_RUN } from '../../data/home';
import { NOTES } from '../../data/notes';
import { EMAIL, MAILTO, url } from '../../site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap grid">
    <div class="copy fade-up">
      <a class="ann" href={url('work/')}><b>New</b>{NOTES.length} case notes from eight years at Hive <span aria-hidden="true">→</span></a>
      <h1 id="hero-title" class="page-title">Ship faster and calmer, <em>with help from someone who's done it.</em></h1>
      <p class="lede">
        I'm Craig. I've spent eight years leading engineering at a B2B SaaS company, from its early days to acquisition: from
        release days to shipping every merge, and from trying AI tools to AI-first. I help startups and small teams make the
        same moves, at a pace that suits them.
      </p>
      <div class="cmdbox mono">
        <span class="p" aria-hidden="true">$</span>
        <span class="v">mail <a href={MAILTO}>{EMAIL}</a></span>
        <button type="button" class="copy-btn" data-copy={EMAIL} hidden>
          <Icon name="copy" size={15} /><span data-copy-label>Copy</span><span class="visually-hidden"> the email address</span>
        </button>
      </div>
      <div class="ctas">
        <a class="btn btn-primary" href={MAILTO}>Book a free 30-minute call <span aria-hidden="true">→</span></a>
        <a class="btn btn-secondary" href={url('#services')}>See how I can help</a>
      </div>
      <p class="note">No pitch deck, no hard sell. If I'm not the right fit, I'll say so.</p>
    </div>
    <div class="stage">
      <Terminal path="~/your-product" cmd="craigsworks health-check" lines={HERO_RUN} name="health check">
        <p class="toast" aria-hidden="true">
          <span class="badge badge-ok"><Icon name="check" size={16} /></span>
          <span><strong>plan.md written</strong><span>5 changes, ranked by impact</span></span>
        </p>
      </Terminal>
      <p class="note right">An illustrative run, not a real client's.</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 64px 0 88px;
    border-bottom: 1px solid var(--line);
  }
  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    pointer-events: none;
    background: radial-gradient(closest-side, var(--glow), transparent);
  }
  .hero::before {
    width: 900px;
    height: 700px;
    right: -260px;
    top: -300px;
  }
  .hero::after {
    width: 700px;
    height: 520px;
    left: -320px;
    bottom: -330px;
    opacity: 0.8;
  }
  .grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(440px, 100%), 1fr));
    gap: 56px;
    align-items: center;
  }
  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    min-width: 0;
  }
  .page-title {
    margin: 0;
  }
  .ann {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 4px 14px 4px 4px;
    border: 1px solid var(--line2);
    border-radius: 99px;
    background: var(--tile);
    font-size: 0.875rem;
    color: var(--text);
    text-decoration: none;
  }
  .ann b {
    padding: 2px 9px;
    border-radius: 99px;
    background: var(--acc);
    color: var(--on-acc);
    font-size: 0.75rem;
  }
  .ann:hover {
    border-color: var(--acc-mid);
    color: var(--ink);
  }
  .lede {
    margin: 0;
    max-width: 36rem;
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--text);
  }
  .cmdbox {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 100%;
    min-height: 50px;
    padding: 6px 6px 6px 16px;
    border: 1px solid var(--line2);
    border-radius: 12px;
    background: var(--tile);
    font-size: 0.875rem;
  }
  .p {
    color: var(--acc-ink);
  }
  .v {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 38px;
    padding: 0 12px;
    border: 1px solid var(--line2);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
    font: 600 0.75rem var(--f-mono);
    cursor: pointer;
  }
  .copy-btn:hover {
    border-color: var(--acc-mid);
    color: var(--ink);
  }
  .copy-btn[hidden] {
    display: none;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .note {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .stage {
    min-width: 0;
  }
  .right {
    margin-top: 34px;
    text-align: right;
  }
  .toast {
    position: absolute;
    right: -12px;
    bottom: -22px;
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 10px 16px 10px 10px;
    border: 1px solid var(--line2);
    border-radius: 12px;
    background: var(--tile);
    box-shadow: 0 20px 40px -16px rgba(14, 12, 10, 0.45);
    font-size: 0.8125rem;
    pointer-events: none;
    animation: toast 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.3) backwards;
  }
  .toast strong,
  .toast span span {
    display: block;
  }
  .toast span span {
    font-size: 0.75rem;
    color: var(--muted);
  }
  :global(.typing) .toast {
    visibility: hidden;
  }
  @keyframes toast {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.96);
    }
  }
  @media (max-width: 760px) {
    .hero {
      padding-top: 40px;
    }
    .toast {
      right: 8px;
    }
  }
</style>
