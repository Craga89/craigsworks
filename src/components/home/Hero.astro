---
// The opening: who this is, what it's for, and a few results from real work beside it.
import { MAILTO, url } from '../../site';

const STATS = [
  { label: 'releases', title: 'No release train since 2022', body: 'Every merge reaches customers on its own.' },
  { label: 'ai', title: 'AI-first in a year', body: 'Most code AI-written, reviewed by AI and people.' },
];
const FIGURES = [
  { label: 'typechecks', value: '~10×', body: 'faster on TypeScript 7' },
  { label: 'aws', value: '$1.3k', body: 'a month, from the first three cuts' },
];
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="copy fade-up">
    <p class="kicker">engineering consultancy · newcastle upon tyne · remote</p>
    <h1 id="hero-title" class="page-title">Ship faster and calmer, with help from someone who's done it.</h1>
    <p class="lede">
      I'm Craig. I've spent the last eight years leading engineering at a B2B SaaS company, from its early days through
      to acquisition. Along the way we went from release days to shipping every merge, and from trying AI tools to a
      team where most code is written by AI and reviewed by AI and people. I help startups and small teams make the same
      moves, at a pace that suits them.
    </p>
    <div class="ctas">
      <a class="btn btn-primary" href={MAILTO}>Book a free 30-minute call</a>
      <a class="btn btn-secondary" href={url('#services')}>See how I can help</a>
    </div>
    <p class="note">No pitch deck, no hard sell. If I'm not the right fit, I'll say so.</p>
  </div>
  <div class="stage">
    <div class="card tile tone-dark on-dark tilt">
      <p class="label">from the last few years · hive hr</p>
      <ul class="stats">
        {
          STATS.map((s) => (
            <li class="stat">
              <span class="label">{s.label}</span>
              <strong>{s.title}</strong>
              <span class="body">{s.body}</span>
            </li>
          ))
        }
        {
          FIGURES.map((s) => (
            <li class="stat half">
              <span class="label">{s.label}</span>
              <strong class="fig">{s.value}</strong>
              <span class="body">{s.body}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 40px;
    align-items: center;
    padding-top: 56px;
  }
  @media (max-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }
  .note {
    margin: 14px 0 0;
  }
  .stage {
    perspective: 1400px;
  }
  .card {
    padding: 24px;
  }
  .tilt {
    transform: rotate(-1.2deg);
    transform-origin: 0 50%;
    animation: tilt 1.6s var(--ease) 0.2s both;
  }
  .card:hover {
    transform: rotate(-1.2deg) translateY(-3px);
  }
  .stats {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .stat {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 16px;
    border-radius: 16px;
    background: var(--dark-raised);
  }
  .stat.half {
    grid-column: span 1;
  }
  .stat .label {
    margin: 0;
  }
  strong {
    font-size: 1.375rem;
    line-height: 1.2;
    color: #ffffff;
  }
  .fig {
    font-size: 1.75rem;
    color: var(--dark-acc);
  }
  .body {
    font-size: 0.875rem;
    color: var(--dark-text);
  }
  @media (max-width: 420px) {
    .stat.half {
      grid-column: span 2;
    }
  }
</style>
