---
// How an engagement runs, step by step.
import SectionHead from '../ui/SectionHead.astro';
import Steps from '../ui/Steps.astro';
import { STEPS } from '../../data/services';
---

<section id="how" class="section wrap" aria-labelledby="how-title">
  <SectionHead
    id="how"
    kicker="how it works"
    title="Small steps, no lock-in"
    sub="You can stop after any step and keep everything we've made so far."
  />
  <Steps steps={STEPS} />
</section>
