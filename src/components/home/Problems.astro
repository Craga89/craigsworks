---
// "Sound familiar?": the problems people bring, each with what has worked before.
import SectionHead from '../ui/SectionHead.astro';
import { PROBLEMS } from '../../data/home';
---

<section id="problems" class="section wrap" aria-labelledby="problems-title">
  <SectionHead
    id="problems"
    kicker="sound familiar?"
    title="The problems I'm usually asked about"
    sub="These are the ones I've lived with and worked through myself, so the fixes come from experience rather than a playbook."
  />
  <ul class="bento list">
    {
      PROBLEMS.map((p) => (
        <li class="tile c4 pop">
          <h3>{p.title}</h3>
          <p class="muted small">{p.body}</p>
          <p class="fit">
            <span class="label">what's worked before</span>
            {p.before}
          </p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .list li {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .fit {
    font-size: 0.9375rem;
    padding-top: 14px;
  }
  .fit .label {
    margin-bottom: 4px;
  }
</style>
