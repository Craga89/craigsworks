---
// Proof: the numbers, the track record as a terminal, and qTip2 (with a tooltip, naturally).
import SectionHead from '../ui/SectionHead.astro';
import { RECORD, USED_BY } from '../../data/home';
---

<section id="record" class="section wrap" aria-labelledby="record-title">
  <SectionHead
    id="record"
    kicker="track record"
    title="Grounded in real work"
    sub="Everything here comes from teams and platforms I've led. The case notes go into the detail."
  />
  <div class="bento">
    <div class="tile c4 tone-acc pop">
      <p class="label">experience</p>
      <p class="big">20+</p>
      <p class="after">years building software, still hands-on</p>
    </div>
    <div class="tile c4 pop">
      <p class="label">journey</p>
      <p class="big mid">Startup → exit</p>
      <p class="after muted">Led engineering at a B2B SaaS company through to its acquisition, and through due diligence</p>
    </div>
    <div class="tile c4 pop">
      <p class="label">teams</p>
      <p class="big">12</p>
      <p class="after muted">engineers led at the largest, 10+ hired, in-house and outsourced</p>
    </div>
    <div class="term tile c7 on-dark mono pop">
      <p class="prompt line-in"><span aria-hidden="true">$ </span>cat track-record.txt</p>
      <ul>
        {
          RECORD.map((line) => (
            <li class="line-in">
              <span class="ok" aria-hidden="true">
                ✓
              </span>{' '}
              {line}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="tile c5 oss pop">
      <p class="label">open source</p>
      <h3>
        <span class="tip-wrap" data-tip>
          <button type="button" class="tip-btn" aria-describedby="qtip-demo">qTip2</button>
          <span id="qtip-demo" role="tooltip" class="tip">Yes, a tooltip. I wrote the library, so it seemed only fair. Escape hides it.</span>
        </span>
      </h3>
      <p class="muted small">
        The jQuery tooltip library I wrote and maintained, featured in <i>Smashing jQuery</i> (2011). It and its predecessors
        ran on sites for:
      </p>
      <ul class="chips">
        {USED_BY.slice(0, 5).map((n) => <li class="chip">{n}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .after {
    margin-top: 8px !important;
  }
  .mid {
    font-size: 2.5rem;
  }
  .term {
    background: var(--dark);
    border-color: transparent;
    color: #efe6d8;
    font-size: 0.875rem;
    line-height: 1.85;
    overflow-wrap: anywhere;
  }
  .prompt {
    margin: 0 0 8px !important;
    color: var(--dark-acc);
  }
  .term ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ok {
    color: #7fd6a8;
  }
  .oss {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .oss h3 {
    margin: 0;
  }
  .tip-wrap {
    position: relative;
    display: inline-block;
  }
  .tip-btn {
    min-height: 44px;
    padding: 0 14px;
    border: 1px dashed var(--acc-mid);
    border-radius: 12px;
    background: var(--acc-soft);
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    cursor: help;
  }
  .tip {
    position: absolute;
    left: 0;
    bottom: calc(100% + 10px);
    z-index: 5;
    width: max-content;
    max-width: min(280px, 70vw);
    padding: 10px 12px;
    border-radius: 12px;
    background: var(--ink);
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition:
      opacity 0.2s,
      transform 0.2s,
      visibility 0.2s;
  }
  .tip::after {
    content: '';
    position: absolute;
    left: 22px;
    top: 100%;
    border: 7px solid transparent;
    border-top-color: var(--ink);
  }
  .tip-wrap:hover .tip,
  .tip-wrap:focus-within .tip {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .tip-wrap[data-dismissed] .tip {
    opacity: 0;
    visibility: hidden;
  }
</style>
