---
// Proof: the track record as a terminal, the years, the qTip2 tooltip, and who's behind it.
import { RECORD } from '../../data/services';
import { PERSONAL_SITE, OWNER, LOCATION } from '../../site';
---

<section id="record" class="section wrap" aria-labelledby="record-title">
  <h2 id="record-title" class="section-title pop">Done it, <span class="soft">in production.</span></h2>
  <div class="bento grid">
    <div class="term tile pop on-dark mono">
      <p class="prompt line-in"><span aria-hidden="true">$ </span>cat track-record.txt</p>
      <ul>
        {
          RECORD.map((line) => (
            <li class="line-in">
              <span class="arrow" aria-hidden="true">
                →
              </span>{' '}
              {line}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="years tile pop">
      <p class="num">20+</p>
      <p>years writing software, still hands-on</p>
    </div>
    <div class="qtip tile pop">
      <p>I wrote <strong>qTip2</strong>, an open source tooltip library. So naturally…</p>
      <span class="tip-wrap" data-tip>
        <button type="button" class="tip-btn" aria-describedby="qtip-demo">Hover or focus me</button>
        <span id="qtip-demo" role="tooltip" class="tip">…this tile has a tooltip. Escape hides it.</span>
      </span>
    </div>
    <div class="who tile pop">
      <p>Hi, I'm {OWNER.split(' ')[0]}. Full-stack engineer and Head of Engineering, {LOCATION}.</p>
      <a href={PERSONAL_SITE}>More about me at craigthompson.dev <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .grid {
    grid-auto-rows: minmax(150px, auto);
  }
  .term {
    grid-column: span 7;
    grid-row: span 2;
    background: var(--dark);
    color: #e8ebf0;
    font-size: 0.875rem;
    line-height: 1.85;
    overflow-wrap: anywhere;
  }
  .prompt {
    margin: 0 0 12px;
    color: var(--dark-muted);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .arrow {
    color: var(--dark-acc);
  }
  .years {
    grid-column: span 5;
    background: var(--acc);
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .years p {
    margin: 0;
    font-weight: 600;
  }
  .years .num {
    font-weight: 800;
    font-size: 4rem;
    line-height: 0.9;
    letter-spacing: -0.05em;
  }
  .qtip {
    grid-column: span 5;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
  }
  .qtip p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .qtip strong {
    color: var(--ink);
  }
  .tip-wrap {
    position: relative;
    align-self: flex-start;
  }
  .tip-btn {
    min-height: 44px;
    padding: 0 18px;
    border: 2px solid var(--ink);
    border-radius: 12px;
    background: var(--tile);
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    font-size: 0.9375rem;
    cursor: help;
  }
  .tip {
    position: absolute;
    left: 0;
    bottom: calc(100% + 10px);
    width: max-content;
    max-width: min(240px, 70vw);
    padding: 8px 12px;
    border-radius: 10px;
    background: var(--ink);
    color: #ffffff;
    font-size: 0.875rem;
    visibility: hidden;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.2s,
      transform 0.2s,
      visibility 0.2s;
  }
  .tip-wrap:hover .tip,
  .tip-btn:focus + .tip {
    visibility: visible;
    opacity: 1;
    transform: none;
  }
  .tip-wrap[data-dismissed] .tip {
    visibility: hidden;
    opacity: 0;
  }
  .who {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
  }
  .who p {
    margin: 0;
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: -0.02em;
  }
  .who a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
  }
</style>
