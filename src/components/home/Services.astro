---
// The three services as tabs (scripts/tabs.ts). Without scripts, each panel shows in turn.
import { SERVICES } from '../../data/services';

const tones = ['tone-soft', 'tone-ink', 'tone-acc'] as const;
---

<section id="services" class="section wrap" aria-labelledby="services-title">
  <div class="card pop" data-tabs>
    <div class="top">
      <h2 id="services-title" class="section-title">Pick a dial. <span class="soft">I'll turn it.</span></h2>
      <div class="tablist" role="tablist" aria-label="Services">
        {
          SERVICES.map((s, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${s.id}`}
              aria-controls={`panel-${s.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {s.tab}
            </button>
          ))
        }
      </div>
    </div>
    {
      SERVICES.map((s, i) => (
        <div
          class="panel bento"
          role="tabpanel"
          id={`panel-${s.id}`}
          aria-labelledby={`tab-${s.id}`}
          tabindex="0"
          data-later={i > 0 ? '' : undefined}
        >
          <div class="main tile">
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <p class="note mono">{s.note}</p>
          </div>
          <ol class="steps">
            {s.steps.map((step, n) => (
              <li class:list={['step tile', tones[n]]}>
                <span class="n mono" aria-hidden="true">
                  0{n + 1}
                </span>
                <span class="t">{step}</span>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </div>
</section>

<style>
  .card {
    background: var(--tile);
    border-radius: var(--r-tile);
    padding: clamp(24px, 4vw, 44px);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }
  .top .section-title {
    margin: 0;
  }
  .tablist {
    display: none;
    flex-wrap: wrap;
    gap: 6px;
    padding: 5px;
    background: var(--bg);
    border-radius: 14px;
  }
  :global(.js) .tablist {
    display: flex;
  }
  :global(.js) [data-later] {
    display: none;
  }
  [role='tab'] {
    min-height: 44px;
    padding: 0 16px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 700;
    cursor: pointer;
  }
  [role='tab'][aria-selected='true'] {
    background: var(--tile);
    color: var(--ink);
    box-shadow: 0 1px 2px rgba(11, 13, 18, 0.08);
  }
  [role='tab']:hover {
    color: var(--ink);
  }
  .panel {
    animation: swap 0.45s var(--ease) both;
  }
  .panel + .panel {
    margin-top: 12px;
  }
  :global(.js) .panel + .panel {
    margin-top: 0;
  }
  .panel[hidden] {
    display: none;
  }
  .main {
    grid-column: span 6;
    background: var(--bg);
  }
  h3 {
    margin: 0 0 12px;
    font-weight: 800;
    font-size: 1.75rem;
    letter-spacing: -0.03em;
  }
  .main p {
    margin: 0 0 20px;
    color: var(--text);
  }
  .main .note {
    display: inline-block;
    margin: 0;
    padding: 6px 12px;
    border-radius: 10px;
    background: var(--tile);
    font-size: 0.8125rem;
    color: var(--ink);
  }
  .steps {
    grid-column: span 6;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (max-width: 760px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .step {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    min-height: 160px;
    padding: 20px;
    border-radius: 20px;
  }
  .n {
    font-size: 0.75rem;
  }
  .t {
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.25;
  }
  .tone-soft {
    background: var(--acc-soft);
    color: var(--ink);
  }
  .tone-ink {
    background: var(--dark);
    color: #ffffff;
  }
  .tone-acc {
    background: var(--acc);
    color: #ffffff;
  }
</style>
