---
// The three services, each leading to its own page.
import SectionHead from '../ui/SectionHead.astro';
import Flow from '../ui/Flow.astro';
import { service } from '../../data/services';
import { url } from '../../site';

const rel = service('release-acceleration');
const ai = service('ai-adoption');
const hc = service('health-check');
const href = (slug: string) => url(`services/${slug}/`);
---

<section id="services" class="section wrap" aria-labelledby="services-title">
  <SectionHead
    id="services"
    kicker="how i can help"
    title="Three ways to work together"
    sub="Most teams start with a health check, then pick the one or two things that would make the biggest difference."
  />
  <div class="bento">
    <article class="tile c7 main pop">
      <p class="label">{rel.name.toLowerCase()}</p>
      <h3 class="lead">Get merged work to customers quickly, without a release day</h3>
      <p class="muted">{rel.summary}</p>
      <Flow
        label="How a change gets to customers"
        steps={['merge', 'what changed', 'build that', 'checks', { text: 'preview', tone: 'acc' }, { text: 'live', tone: 'ok' }]}
      />
      <ul class="ticks">
        <li>Builds that only rebuild what a change touched</li>
        <li>A preview of every change before it merges</li>
        <li>Deploys that check they're healthy, and roll back if not</li>
      </ul>
      <a class="more" href={href(rel.slug)}>How release acceleration works <span aria-hidden="true">→</span></a>
    </article>
    <div class="c5 side">
      <article class="tile tone-soft pop">
        <p class="label">{ai.name.toLowerCase()}</p>
        <h3>AI coding and review, with the standards that keep quality high</h3>
        <p class="small">{ai.summary}</p>
        <a class="more" href={href(ai.slug)}>How AI adoption works <span aria-hidden="true">→</span></a>
      </article>
      <article class="tile tone-acc pop">
        <p class="label">{hc.name.toLowerCase()}</p>
        <h3>A clear look at where you are, and a ranked plan you keep</h3>
        <p class="small">{hc.summary}</p>
        <a class="more" href={href(hc.slug)}>What the health check covers <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </div>
</section>

<style>
  .main,
  .side .tile {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .main .more {
    margin-top: auto;
  }
  .lead {
    font-size: clamp(1.5rem, 2.6vw, 1.875rem);
    letter-spacing: -0.025em;
  }
  .side {
    display: grid;
    gap: 16px;
  }
  .tone-acc .more {
    color: var(--on-acc);
  }
</style>
