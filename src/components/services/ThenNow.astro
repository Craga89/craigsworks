---
// A before-and-after: how something was, and how it is now.
interface Props {
  then: { label: string; title: string; items: string[] };
  now: { label: string; title: string; items: string[] };
}
const { then, now } = Astro.props;
---

<div class="story pop">
  <div class="then">
    <p class="label">{then.label}</p>
    <h3>{then.title}</h3>
    <ul class="dash">{then.items.map((i) => <li>{i}</li>)}</ul>
  </div>
  <div class="now">
    <p class="label">{now.label}</p>
    <h3>{now.title}</h3>
    <ul class="ticks">{now.items.map((i) => <li set:html={i} />)}</ul>
  </div>
</div>

<style>
  .story {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--line);
    border-radius: var(--r-tile);
    overflow: hidden;
    background: var(--tile);
  }
  @media (max-width: 760px) {
    .story {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .then,
  .now {
    padding: 28px;
  }
  .then {
    border-right: 1px solid var(--line);
  }
  @media (max-width: 760px) {
    .then {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }
  .now {
    background: var(--acc-soft);
  }
  h3 {
    margin: 0 0 12px;
    font-size: 1.375rem;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  ul {
    font-size: 1rem;
  }
</style>
