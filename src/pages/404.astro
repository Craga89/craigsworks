---
// Not found: GitHub Pages serves this for any missing address.
import Base from '../layouts/Base.astro';
import { PERSONAL_SITE, url } from '../site';
---

<Base
  title="Not found · craigsworks"
  description="That address doesn't exist on craigsworks.com."
  path="404.html"
  contact={false}
>
  <section class="nf wrap" aria-labelledby="nf-title">
    <div class="tile">
      <p class="mono code">404</p>
      <h1 id="nf-title">That page isn't here.</h1>
      <p>
        craigsworks.com used to be Craig's personal site. That now lives at <a href={PERSONAL_SITE}>craigthompson.dev</a
        >, and old qTip2 pages have moved to <a href="https://github.com/qTip2/qTip2">qTip2 on GitHub</a>.
      </p>
      <a class="btn btn-primary" href={url()}>Go to the home page</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-top: 72px;
    padding-bottom: 72px;
  }
  .tile {
    max-width: 640px;
    padding: clamp(28px, 5vw, 48px);
  }
  .code {
    margin: 0 0 12px;
    color: var(--muted);
  }
  h1 {
    margin: 0 0 16px;
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }
  p {
    margin: 0 0 24px;
    color: var(--text);
  }
</style>
