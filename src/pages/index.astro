---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Problems from '../components/home/Problems.astro';
import Services from '../components/home/Services.astro';
import Outcomes from '../components/home/Outcomes.astro';
import Record from '../components/home/Record.astro';
import Notes from '../components/home/Notes.astro';
import How from '../components/home/How.astro';
import AboutBrief from '../components/home/AboutBrief.astro';
import Faq from '../components/ui/Faq.astro';
import Contact from '../components/Contact.astro';
import { FAQ } from '../data/home';
import { HOME_TITLE, HOME_DESC } from '../site';
---

<Base title={HOME_TITLE} description={HOME_DESC} path="" mono>
  <Hero />
  <Problems />
  <Services />
  <Outcomes />
  <Record />
  <Notes />
  <How />
  <AboutBrief />
  <Faq id="faq" title="Things people ask" items={FAQ} />
  <Contact />
</Base>
